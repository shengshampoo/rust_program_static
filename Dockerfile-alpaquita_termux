FROM bellsoft/alpaquita-linux-base:stream-glibc

RUN apk update
RUN apk upgrade

# required Rustup compile
RUN apk add --no-cache \
  git curl libstdc++ cmake bash make \
  clang21 clang21-static clang21-dev llvm21
  

ENV XZ_OPT=-e9
COPY build-termux-rust.sh build-termux-rust.sh
RUN chmod +x ./build-termux-rust.sh
RUN bash ./build-termux-rust.sh
